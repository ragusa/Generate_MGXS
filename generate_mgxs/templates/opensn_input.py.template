"""Generated OpenSn input using the run-relative OpenMC MGXS HDF5 handoff.

Normally invoke as ``opensn-console -i input.py``.  This file reads
``../openmc/mgxs.h5`` and writes ``opensn_result.json`` beside itself.
"""

import json
import math
from pathlib import Path

import numpy as np


# --- Human-readable case definition ---------------------------------------
CASE_NAME = __CASE_NAME__
MATERIALS = __MATERIALS__

# This is the same physical authority used to build the continuous OpenMC source.
PHYSICAL_SOURCE = __PHYSICAL_SOURCE__

# Only convergence controls remain case-specific. Geometry and angular settings
# below deliberately define a fixed, inexpensive verification problem.
OPENSN_NUMERICAL_SETTINGS = __NUMERICAL__

VERIFICATION = {
    "cube_side_cm": 2.0,
    "cells_per_axis": 2,
    "cell_count": 8,
    "volume_cm3": 8.0,
    "n_polar": 2,
    "n_azimuthal": 4,
    "angular_directions": 8,
    "scattering_order": 0,
}


# --- Energy-group data and run-relative paths -----------------------------
# Canonical Python data are ascending; OpenSn group zero is highest energy.
ENERGY_BOUNDS_EV_ASCENDING = np.asarray(__ENERGY_BOUNDS__, dtype=float)
RUN_DIRECTORY = Path(__file__).resolve().parents[1]
MGXS_HDF5 = RUN_DIRECTORY / "openmc" / "mgxs.h5"
RESULT_PATH = RUN_DIRECTORY / "opensn" / "opensn_result.json"
NUM_GROUPS = ENERGY_BOUNDS_EV_ASCENDING.size - 1

CONFIG = {
    "case_name": CASE_NAME,
    "materials": MATERIALS,
    **OPENSN_NUMERICAL_SETTINGS,
}


def source_probabilities():
    """Derive integrated group masses in ascending physical-energy order."""
    kind = PHYSICAL_SOURCE["kind"]

    if kind == "grouped":
        masses = np.asarray(PHYSICAL_SOURCE["probabilities"], dtype=float)
        if masses.shape != (NUM_GROUPS,) or np.any(masses < 0.0):
            raise ValueError("source must provide one nonnegative mass per group")
        if not np.isclose(masses.sum(), 1.0, rtol=0.0, atol=1.0e-12):
            raise ValueError("explicit group probabilities must sum to one")
        return masses

    elif kind == "uniform_energy":
        masses = np.diff(ENERGY_BOUNDS_EV_ASCENDING)

    elif kind == "watt":
        bounds_mev = ENERGY_BOUNDS_EV_ASCENDING / 1.0e6

        # Match case preparation exactly so both solvers receive probabilities
        # integrated from the same physical Watt spectrum.
        nodes, weights = np.polynomial.legendre.leggauss(64)
        masses = []
        for low, high in zip(bounds_mev[:-1], bounds_mev[1:]):
            energies = 0.5 * (high - low) * nodes + 0.5 * (high + low)
            density = np.exp(-energies / PHYSICAL_SOURCE["a_mev"]) * np.sinh(
                np.sqrt(PHYSICAL_SOURCE["b_per_mev"] * energies)
            )
            masses.append(0.5 * (high - low) * np.dot(weights, density))
        masses = np.asarray(masses)
    else:
        raise ValueError(f"unsupported physical source kind: {kind}")

    if masses.shape != (NUM_GROUPS,) or np.any(masses < 0.0):
        raise ValueError("source must provide one nonnegative mass per group")

    masses = masses / masses.sum()
    masses[-1] += 1.0 - masses.sum()

    return masses


SOURCE_PROBABILITIES_ASCENDING = source_probabilities()


# --- Fixed verification mesh ----------------------------------------------
# OpenSn verifies each HDF5 material independently; it never reconstructs the
# OpenMC target/moderator geometry. Three nodes per axis give exactly 8 cells.
half_width = VERIFICATION["cube_side_cm"] / 2.0
axis_nodes = np.linspace(
    -half_width,
    half_width,
    VERIFICATION["cells_per_axis"] + 1,
).tolist()
nodes = [axis_nodes, axis_nodes, axis_nodes]
grid = OrthogonalMeshGenerator(node_sets=nodes).Execute()
grid.SetUniformBlockID(0)

verification_volume = RPPLogicalVolume(
    xmin=-half_width,
    xmax=half_width,
    ymin=-half_width,
    ymax=half_width,
    zmin=-half_width,
    zmax=half_width,
)

measured_volumes = {
    int(block): float(volume) for block, volume in grid.ComputeVolumePerBlockID().items()
}
if not math.isclose(
    measured_volumes.get(0, 0.0),
    VERIFICATION["volume_cm3"],
    rel_tol=1.0e-12,
    abs_tol=1.0e-12,
):
    raise ValueError(
        f"fixed OpenSn verification cube has the wrong volume: {measured_volumes}"
    )

# --- Angular discretization and reflected boundaries ----------------------
# The direct scalar-flux balance contains only scatter P0. For an isotropic
# source in a homogeneous reflected medium, higher moments add angular work but
# no information to this comparison.
REFLECTING_BOUNDARIES = [
    {"name": "xmin", "type": "reflecting"},
    {"name": "xmax", "type": "reflecting"},
    {"name": "ymin", "type": "reflecting"},
    {"name": "ymax", "type": "reflecting"},
    {"name": "zmin", "type": "reflecting"},
    {"name": "zmax", "type": "reflecting"},
]

# --- Fixed source ---------------------------------------------------------
if SOURCE_PROBABILITIES_ASCENDING.shape != (NUM_GROUPS,):
    raise ValueError("source must contain one integrated probability per group")
if np.any(SOURCE_PROBABILITIES_ASCENDING < 0.0) or not math.isclose(
    float(SOURCE_PROBABILITIES_ASCENDING.sum()), 1.0, abs_tol=1e-12
):
    raise ValueError("source group probabilities must be nonnegative and sum to one")
# OpenSn numbers group 0 at highest energy, so reverse the ascending physical
# source vector at this boundary only. Division by the fixed cube volume makes
# the volume-integrated source exactly one particle for every domain solve.
source_strength_high_to_low = (
    SOURCE_PROBABILITIES_ASCENDING[::-1] / VERIFICATION["volume_cm3"]
)
if not math.isclose(
    float(source_strength_high_to_low.sum() * VERIFICATION["volume_cm3"]),
    1.0,
    abs_tol=1.0e-12,
):
    raise ValueError("fixed OpenSn volumetric source does not integrate to one")


def volume_integral(field, volume):
    """Integrate one group flux over the fixed verification cube."""
    interpolation = FieldFunctionInterpolationVolume()
    interpolation.SetOperationType("sum")
    interpolation.SetLogicalVolume(volume)
    interpolation.AddFieldFunction(field)
    interpolation.Execute()
    return float(interpolation.GetValue())


# --- Independent material verification solves -----------------------------
# Every OpenMC HDF5 material domain is put into the same block-zero cube and
# solved independently. This verifies each material against the direct
# infinite-medium equation without coupling it to another material or geometry.
if not MGXS_HDF5.is_file():
    raise FileNotFoundError(f"OpenMC MGXS HDF5 is missing: {MGXS_HDF5}")

domain_results = {}
for material in CONFIG["materials"]:
    logical_name = material["logical_name"]
    cross_sections = MultiGroupXS()
    cross_sections.LoadFromOpenMC(
        str(MGXS_HDF5), logical_name, material["temperature_k"]
    )

    quadrature = GLCProductQuadrature3DXYZ(
        n_polar=VERIFICATION["n_polar"],
        n_azimuthal=VERIFICATION["n_azimuthal"],
        scattering_order=VERIFICATION["scattering_order"],
    )
    groupsets = [{
        "groups_from_to": (0, NUM_GROUPS - 1),
        "angular_quadrature": quadrature,
        "inner_linear_method": "petsc_gmres",
        "l_abs_tol": CONFIG["gmres_tolerance"],
        "l_max_its": CONFIG["gmres_max_iterations"],
        "gmres_restart_interval": CONFIG["gmres_restart"],
    }]
    problem = DiscreteOrdinatesProblem(
        mesh=grid,
        num_groups=NUM_GROUPS,
        groupsets=groupsets,
        xs_map=[{"block_ids": [0], "xs": cross_sections}],
        boundary_conditions=REFLECTING_BOUNDARIES,
        options={"save_angular_flux": False},
    )
    problem.SetVolumetricSources(
        volumetric_sources=[
            VolumetricSource(
                block_ids=[0],
                group_strength=source_strength_high_to_low.tolist(),
            )
        ]
    )

    # Delimit each solve so the Python runner can require explicit convergence
    # independently for every HDF5 material domain.
    if globals().get("rank", 0) == 0:
        print(f"GENERATE_MGXS_DOMAIN_BEGIN {logical_name}", flush=True)
    solver = SteadyStateSourceSolver(problem=problem, compute_balance=True)
    solver.Initialize()
    solver.Execute()
    if globals().get("rank", 0) == 0:
        print(f"GENERATE_MGXS_DOMAIN_END {logical_name}", flush=True)

    balance_values = {
        name: float(value) for name, value in solver.ComputeBalanceTable().items()
    }
    fields_high_to_low = problem.GetScalarFluxFieldFunction()
    if len(fields_high_to_low) != NUM_GROUPS:
        raise ValueError("OpenSn did not expose one scalar-flux field per group")

    flux_high_to_low = np.asarray([
        volume_integral(field, verification_volume) for field in fields_high_to_low
    ])
    # OpenSn group zero is highest energy; serialize package-facing values in
    # ascending physical-energy order without changing the HDF5 group contract.
    flux_ascending = flux_high_to_low[::-1]
    balance = balance_values.get(
        "balance",
        balance_values.get("production_rate", 0.0)
        + balance_values.get("inflow_rate", 0.0)
        - balance_values.get("absorption_rate", 0.0)
        - balance_values.get("outflow_rate", 0.0),
    )
    domain_results[logical_name] = {
        "block": 0,
        "volume_cm3": VERIFICATION["volume_cm3"],
        "flux": flux_ascending.tolist(),
        "balance": float(balance),
    }

primary = next(
    item["logical_name"] for item in CONFIG["materials"]
    if item["role"] in ("homogeneous", "target")
)
result = {
    "energy_bounds": ENERGY_BOUNDS_EV_ASCENDING.tolist(),
    "flux": domain_results[primary]["flux"],
    "logical_domain": primary,
    "domains": domain_results,
    "verification": VERIFICATION,
    "solver": {
        "converged": None,
        "iterations": None,
        "residual": None,
        "tolerance": CONFIG["gmres_tolerance"],
        "maximum_iterations": CONFIG["gmres_max_iterations"],
        "balance": domain_results[primary]["balance"],
    },
}

if globals().get("rank", 0) == 0:
    # MPI ranks share RESULT_PATH; only rank zero writes the compact handoff.
    RESULT_PATH.write_text(
        json.dumps(result, indent=2, sort_keys=True, allow_nan=False) + "\n"
    )
